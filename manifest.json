{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "src/icons/16.png",
    "32": "src/icons/32.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "src/icons/16.png",
      "32": "src/icons/32.png",
      "48": "src/icons/48.png",
      "128": "src/icons/128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-B7YgdLml.js"
      ],
      "matches": [
        "https://vibes.ai/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "downloads.open",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://vibes.ai/*",
    "https://glab.duckmartians.info/*",
    "https://www.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://vibes.ai/*"
      ],
      "resources": [
        "src/icons/128.png"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://vibes.ai/*"
      ],
      "resources": [
        "assets/blobStore-BgzRMnVw.js",
        "assets/adapter-CtN3-cvw.js",
        "assets/policy-DgpzwzU7.js",
        "assets/index.ts-eYcnD4Uc.js"
      ],
      "use_dynamic_url": false
    }
  ]
}